generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               Int       @id @default(autoincrement())
  name             String
  gstin            String?   @unique
  phone            String?
  email            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  stateCode        String? // e.g., '24' for Gujarat
  // Bank details
  bankName         String?
  bankAccount      String?
  bankBranch       String?
  ifsc             String?
  // Additional fields
  logoUrl          String?
  isOrganization   Boolean   @default(false) // true = your company, false = customer
  createdBy        Int?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invoicesAsSeller Invoice[] @relation("SellerInvoices")
  invoicesAsBuyer  Invoice[] @relation("BuyerInvoices")
  creator          User?     @relation(fields: [createdBy], references: [id])

  @@index([name])
  @@index([gstin])
  @@index([createdBy])
  @@index([isDeleted])
}

model Invoice {
  id                Int           @id @default(autoincrement())
  invoiceNo         String        @unique
  date              DateTime
  heading           String        @default("TAX INVOICE") // TAX INVOICE, DELIVERY CHALLAN, or custom
  sellerId          Int
  buyerId           Int
  // Additional invoice fields
  referenceNo       String?
  otherReference    String?
  buyerOrderNo      String?
  buyerOrderDate    DateTime?
  dispatchDocNo     String?
  dispatchedThrough String?
  destination       String?
  deliveryNote      String?
  deliveryNoteDate  DateTime?
  termsOfDelivery   String?
  modeOfPayment     String?
  terms             String?
  // Status tracking
  status            String        @default("DRAFT") // DRAFT, FINAL, PAID, CANCELLED
  // Totals (cached for performance)
  subtotal          Decimal       @db.Decimal(18, 2)
  sgstRate          Decimal       @db.Decimal(5, 2) // percentage like 0.75
  cgstRate          Decimal       @db.Decimal(5, 2)
  igstRate          Decimal       @default(0) @db.Decimal(5, 2) // For inter-state
  sgstAmount        Decimal       @db.Decimal(18, 2)
  cgstAmount        Decimal       @db.Decimal(18, 2)
  igstAmount        Decimal       @default(0) @db.Decimal(18, 2)
  totalTax          Decimal       @db.Decimal(18, 2)
  rounding          Decimal       @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal       @db.Decimal(18, 2)
  amountInWords     String?
  // Metadata
  createdBy         Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  // Relations
  lines             InvoiceLine[]
  seller            Company       @relation("SellerInvoices", fields: [sellerId], references: [id])
  buyer             Company       @relation("BuyerInvoices", fields: [buyerId], references: [id])
  creator           User?         @relation(fields: [createdBy], references: [id])

  @@index([invoiceNo])
  @@index([date])
  @@index([status])
  @@index([createdBy])
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  // Optional link to product master (for analytics)
  productId   Int?
  // Snapshot fields (editable without affecting master product)
  description String
  hsn         String?
  qty         Decimal  @db.Decimal(18, 3) // 3 decimals for carats
  unit        String?  @default("Cts")
  rate        Decimal  @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  // Tax breakdown per line (for detailed reporting)
  taxPercent  Decimal  @default(1.5) @db.Decimal(5, 2)
  cgstAmount  Decimal  @default(0) @db.Decimal(18, 2)
  sgstAmount  Decimal  @default(0) @db.Decimal(18, 2)
  igstAmount  Decimal  @default(0) @db.Decimal(18, 2)
  // Relations
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String // "Uncut & Polish Diamond"
  description  String? // Detailed description
  hsnCode      String // '71023910'
  unit         String        @default("Cts") // 'Cts', 'Pcs', 'Gms', 'Kgs'
  defaultRate  Decimal?      @db.Decimal(12, 2) // Suggested price
  taxRate      Decimal       @db.Decimal(5, 2) // 1.50, 0.25, 3.00
  isService    Boolean       @default(false) // false=HSN, true=SAC
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  // Relations
  invoiceLines InvoiceLine[]

  @@index([name])
  @@index([hsnCode])
}

model User {
  id                      Int               @id @default(autoincrement())
  name                    String
  email                   String            @unique
  password                String
  role                    String            @default("USER") // ADMIN, USER, ACCOUNTANT
  emailVerified           Boolean           @default(false)
  verificationToken       String?           @unique
  verificationTokenExpiry DateTime?
  resetToken              String?           @unique
  resetTokenExpiry        DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  companies               Company[]
  invoices                Invoice[]
  purchaseInvoices        PurchaseInvoice[]
}

model PurchaseInvoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String
  vendorName    String
  invoiceDate   DateTime
  amount        Decimal  @db.Decimal(18, 2)
  description   String?
  category      String? // e.g., 'Office Supplies', 'Equipment', 'Services'
  fileUrl       String // Cloudinary URL
  publicId      String // Cloudinary public ID for deletion
  fileSize      Int // File size in bytes
  fileName      String
  uploadedBy    Int
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  uploader      User     @relation(fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
  @@index([invoiceDate])
  @@index([vendorName])
  @@index([category])
  @@index([isDeleted])
}

enum LotStatus {
  PURCHASED
  IN_PROCESS
  AT_VENDOR
  READY
  SOLD
  CLOSED
  HOLD
}

enum InventoryState {
  ROUGH
  WIP
  READY_POLISHED
  SOLD
  LOSS
  RETURNED
}

enum ProcessStage {
  CUTTING
  SARIN_MEASUREMENT
  POLISHING
  READY_INVENTORY
  SOLD
}

enum ProcessStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  POSTED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIAL_PAID
  PAID
  CANCELLED
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentStatus {
  PENDING
  CLEARED
  FAILED
  CANCELLED
}

enum PartyType {
  SUPPLIER
  VENDOR
  CUSTOMER
}

enum CostCategory {
  PURCHASE
  CUTTING
  SARIN
  POLISHING
  CERTIFICATION
  MISC
}

enum LotSourceType {
  PURCHASE
  SPLIT
  ADJUSTMENT
}

model Supplier {
  id           Int        @id @default(autoincrement())
  name         String
  code         String?    @unique
  gstin        String?    @unique
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String?
  openingDue   Decimal    @default(0) @db.Decimal(18, 2)
  isActive     Boolean    @default(true)
  createdBy    Int?
  updatedBy    Int?
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]

  @@index([name])
  @@index([isActive])
  @@index([isDeleted])
}

model Vendor {
  id             Int          @id @default(autoincrement())
  name           String
  code           String?      @unique
  vendorType     String?
  specialization String?
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  stateCode      String?
  paymentTerms   String?
  isActive       Boolean      @default(true)
  createdBy      Int?
  updatedBy      Int?
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lotProcesses   LotProcess[]

  @@index([name])
  @@index([isActive])
  @@index([isDeleted])
}

model Customer {
  id           Int      @id @default(autoincrement())
  name         String
  code         String?  @unique
  gstin        String?  @unique
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String?
  openingDue   Decimal  @default(0) @db.Decimal(18, 2)
  isActive     Boolean  @default(true)
  createdBy    Int?
  updatedBy    Int?
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]

  @@index([name])
  @@index([isActive])
  @@index([isDeleted])
}

model Purchase {
  id           Int            @id @default(autoincrement())
  purchaseNo   String         @unique
  supplierId   Int
  purchaseDate DateTime
  referenceNo  String?
  roughWeight  Decimal        @db.Decimal(18, 3)
  totalAmount  Decimal        @db.Decimal(18, 2)
  status       PurchaseStatus @default(DRAFT)
  remarks      String?
  createdBy    Int?
  updatedBy    Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  lots         Lot[]          @relation("PurchaseLots")

  @@index([purchaseNo])
  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
}

model Lot {
  id                 Int                 @id @default(autoincrement())
  lotNo              String              @unique
  sourceType         LotSourceType       @default(PURCHASE)
  sourcePurchaseId   Int?
  parentLotId        Int?
  initialWeight      Decimal             @db.Decimal(18, 3)
  currentWeight      Decimal             @db.Decimal(18, 3)
  status             LotStatus           @default(PURCHASED)
  inventoryState     InventoryState      @default(ROUGH)
  currentStage       ProcessStage        @default(CUTTING)
  currentLocation    String?
  accumulatedCost    Decimal             @default(0) @db.Decimal(18, 2)
  isSaleReady        Boolean             @default(false)
  notes              String?
  createdBy          Int?
  updatedBy          Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sourcePurchase     Purchase?           @relation("PurchaseLots", fields: [sourcePurchaseId], references: [id])
  parentLot          Lot?                @relation("LotParent", fields: [parentLotId], references: [id])
  childLots          Lot[]               @relation("LotParent")
  splitAsSource      LotSplit[]          @relation("SplitSourceLot")
  splitAsChild       LotSplit[]          @relation("SplitChildLot")
  processes          LotProcess[]
  costs              LotCost[]
  saleItems          SaleItem[]
  inventorySnapshots InventorySnapshot[]

  @@index([lotNo])
  @@index([parentLotId])
  @@index([sourcePurchaseId])
  @@index([status])
  @@index([inventoryState])
  @@index([currentStage])
}

model LotSplit {
  id                 Int      @id @default(autoincrement())
  sourceLotId        Int
  childLotId         Int
  splitWeight        Decimal  @db.Decimal(18, 3)
  residualAfterSplit Decimal? @db.Decimal(18, 3)
  splitDate          DateTime @default(now())
  remarks            String?
  createdBy          Int?
  createdAt          DateTime @default(now())
  sourceLot          Lot      @relation("SplitSourceLot", fields: [sourceLotId], references: [id])
  childLot           Lot      @relation("SplitChildLot", fields: [childLotId], references: [id])

  @@index([sourceLotId])
  @@index([childLotId])
  @@index([splitDate])
}

model ProcessType {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  stage        ProcessStage
  sequence     Int
  isActive     Boolean      @default(true)
  description  String?
  createdBy    Int?
  updatedBy    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lotProcesses LotProcess[]

  @@index([stage])
  @@index([sequence])
  @@index([isActive])
}

model LotProcess {
  id               Int           @id @default(autoincrement())
  lotId            Int
  processTypeId    Int
  vendorId         Int?
  status           ProcessStatus @default(PENDING)
  inputWeight      Decimal       @db.Decimal(18, 3)
  outputWeight     Decimal       @db.Decimal(18, 3)
  lossWeight       Decimal       @db.Decimal(18, 3)
  processDate      DateTime
  sentToVendorAt   DateTime?
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  costAmount       Decimal       @default(0) @db.Decimal(18, 2)
  remarks          String?
  createdBy        Int?
  updatedBy        Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lot              Lot           @relation(fields: [lotId], references: [id])
  processType      ProcessType   @relation(fields: [processTypeId], references: [id])
  vendor           Vendor?       @relation(fields: [vendorId], references: [id])

  @@index([lotId])
  @@index([processTypeId])
  @@index([vendorId])
  @@index([status])
  @@index([processDate])
}

model LotCost {
  id          Int          @id @default(autoincrement())
  lotId       Int
  category    CostCategory
  sourceType  String?
  sourceRefId Int?
  amount      Decimal      @db.Decimal(18, 2)
  costDate    DateTime
  remarks     String?
  createdBy   Int?
  createdAt   DateTime     @default(now())
  lot         Lot          @relation(fields: [lotId], references: [id])

  @@index([lotId])
  @@index([category])
  @@index([costDate])
}

model InventorySnapshot {
  id               Int            @id @default(autoincrement())
  snapshotDate     DateTime
  lotId            Int
  status           LotStatus
  inventoryState   InventoryState
  stage            ProcessStage
  location         String?
  weight           Decimal        @db.Decimal(18, 3)
  accumulatedCost  Decimal        @db.Decimal(18, 2)
  availableForSale Boolean        @default(false)
  createdAt        DateTime       @default(now())
  lot              Lot            @relation(fields: [lotId], references: [id])

  @@unique([snapshotDate, lotId])
  @@index([snapshotDate])
  @@index([status])
  @@index([inventoryState])
}

model Sale {
  id          Int        @id @default(autoincrement())
  saleNo      String     @unique
  customerId  Int
  saleDate    DateTime
  status      SaleStatus @default(DRAFT)
  totalWeight Decimal    @db.Decimal(18, 3)
  totalAmount Decimal    @db.Decimal(18, 2)
  notes       String?
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customer    Customer   @relation(fields: [customerId], references: [id])
  items       SaleItem[]

  @@index([saleNo])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
}

model SaleItem {
  id           Int      @id @default(autoincrement())
  saleId       Int
  lotId        Int
  soldWeight   Decimal  @db.Decimal(18, 3)
  ratePerCarat Decimal  @db.Decimal(18, 2)
  lineAmount   Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lot          Lot      @relation(fields: [lotId], references: [id])

  @@index([saleId])
  @@index([lotId])
}

model Payment {
  id                    Int              @id @default(autoincrement())
  paymentNo             String?          @unique
  partyType             PartyType
  partyRefId            Int
  direction             PaymentDirection
  status                PaymentStatus    @default(PENDING)
  amount                Decimal          @db.Decimal(18, 2)
  paymentDate           DateTime
  referenceNo           String?
  linkedTransactionType String?
  linkedTransactionId   Int?
  notes                 String?
  createdBy             Int?
  updatedBy             Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([partyType, partyRefId])
  @@index([direction])
  @@index([status])
  @@index([paymentDate])
}
