generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           Int      @id @default(autoincrement())
  name         String
  gstin        String?  @unique
  phone        String?
  email        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String?  // e.g., '24' for Gujarat
  // Bank details
  bankName     String?
  bankAccount  String?
  bankBranch   String?
  ifsc         String?
  // Additional fields
  logoUrl      String?
  isOrganization Boolean @default(false) // true = your company, false = customer
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  invoicesAsSeller Invoice[] @relation("SellerInvoices")
  invoicesAsBuyer  Invoice[] @relation("BuyerInvoices")
  creator      User?    @relation(fields: [createdBy], references: [id])
  
  @@index([name])
  @@index([gstin])
  @@index([createdBy])
}

model Invoice {
  id              Int        @id @default(autoincrement())
  invoiceNo       String     @unique
  date            DateTime
  sellerId        Int
  buyerId         Int
  // Additional invoice fields
  referenceNo     String?
  otherReference  String?
  buyerOrderNo    String?
  buyerOrderDate  DateTime?
  dispatchDocNo   String?
  dispatchedThrough String?
  destination     String?
  deliveryNote    String?
  deliveryNoteDate DateTime?
  termsOfDelivery String?
  modeOfPayment   String?
  terms           String?
  // Status tracking
  status          String     @default("DRAFT") // DRAFT, FINAL, PAID, CANCELLED
  // Totals (cached for performance)
  subtotal        Decimal    @db.Decimal(18,2)
  sgstRate        Decimal    @db.Decimal(5,2)  // percentage like 0.75
  cgstRate        Decimal    @db.Decimal(5,2)
  igstRate        Decimal    @db.Decimal(5,2)  @default(0) // For inter-state
  sgstAmount      Decimal    @db.Decimal(18,2)
  cgstAmount      Decimal    @db.Decimal(18,2)
  igstAmount      Decimal    @db.Decimal(18,2) @default(0)
  totalTax        Decimal    @db.Decimal(18,2)
  rounding        Decimal    @db.Decimal(18,2) @default(0)
  totalAmount     Decimal    @db.Decimal(18,2)
  amountInWords   String?
  // Metadata
  createdBy       Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  // Relations
  lines           InvoiceLine[]
  seller          Company    @relation("SellerInvoices", fields: [sellerId], references: [id])
  buyer           Company    @relation("BuyerInvoices", fields: [buyerId], references: [id])
  creator         User?      @relation(fields: [createdBy], references: [id])
  
  @@index([invoiceNo])
  @@index([date])
  @@index([status])
  @@index([createdBy])
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  // Optional link to product master (for analytics)
  productId   Int?
  // Snapshot fields (editable without affecting master product)
  description String
  hsn         String?
  qty         Decimal @db.Decimal(18,3) // 3 decimals for carats
  unit        String? @default("Pcs")
  rate        Decimal @db.Decimal(18,2)
  amount      Decimal @db.Decimal(18,2)
  // Tax breakdown per line (for detailed reporting)
  taxPercent  Decimal @db.Decimal(5,2) @default(1.5)
  cgstAmount  Decimal @db.Decimal(18,2) @default(0)
  sgstAmount  Decimal @db.Decimal(18,2) @default(0)
  igstAmount  Decimal @db.Decimal(18,2) @default(0)
  // Relations
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  
  @@index([invoiceId])
  @@index([productId])
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   // "Uncut & Polish Diamond"
  description   String?  // Detailed description
  hsnCode       String   // '71023910'
  unit          String   @default("Pcs") // 'Cts', 'Pcs', 'Gms', 'Kgs'
  defaultRate   Decimal? @db.Decimal(12,2) // Suggested price
  taxRate       Decimal  @db.Decimal(5,2) // 1.50, 0.25, 3.00
  isService     Boolean  @default(false) // false=HSN, true=SAC
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Relations
  invoiceLines  InvoiceLine[]
  
  @@index([name])
  @@index([hsnCode])
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     String @default("USER") // ADMIN, USER, ACCOUNTANT
  emailVerified Boolean @default(false)
  verificationToken String? @unique
  verificationTokenExpiry DateTime?
  resetToken String? @unique
  resetTokenExpiry DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companies Company[]
  invoices  Invoice[]
  purchaseInvoices PurchaseInvoice[]
}

model PurchaseInvoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String
  vendorName    String
  invoiceDate   DateTime
  amount        Decimal  @db.Decimal(18,2)
  description   String?
  category      String?  // e.g., 'Office Supplies', 'Equipment', 'Services'
  fileUrl       String   // Cloudinary URL
  publicId      String   // Cloudinary public ID for deletion
  fileSize      Int      // File size in bytes
  fileName      String
  uploadedBy    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  uploader      User     @relation(fields: [uploadedBy], references: [id])
  
  @@index([uploadedBy])
  @@index([invoiceDate])
  @@index([vendorName])
  @@index([category])
}
